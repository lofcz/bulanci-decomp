{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbulanci/paks/profile.schema.json",
  "title": "OpenBulanci pak profile (load order)",
  "description": "The active pak set, in mount order (low -> high priority). The runtime mounts these onto the layered VFS; higher entries override lower ones.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "paks"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "comment": { "type": "string" },
    "paks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "kind": { "type": "string", "enum": ["master", "mod"] },
          "path": { "type": "string", "description": "Folder under paks/ for mod paks (omitted for the embedded master)." },
          "enabled": { "type": "boolean", "default": true }
        }
      }
    }
  }
}
